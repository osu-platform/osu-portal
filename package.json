{
  "name": "osu-portal",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "pnpm --filter @portal/app-portal dev",
    "dev:https": "pnpm --filter @portal/app-portal dev:https",
    "dev:host": "pnpm --filter @portal/app-module-host dev",
    "build": "pnpm type-check && pnpm --filter @portal/app-portal build",
    "build:host": "pnpm --filter @portal/app-module-host build",
    "preview": "pnpm --filter @portal/app-portal preview",
    "lint": "eslint . --ext ts,tsx --report-unused-disable-directives",
    "lint:strict": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "type-check": "tsc --noEmit",
    "test": "vitest run --project unit",
    "validate-modules": "node scripts/validate-modules.mjs",
    "create-module": "node scripts/create-module.mjs",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "test:storybook": "vitest run --project storybook",
    "dev:demo": "pnpm dev",
    "build:demo": "pnpm build",
    "check:public": "node scripts/public-tree.mjs --check-repository .",
    "prepare:public": "node scripts/public-tree.mjs"
  },
  "lint-staged": {
    "*.{ts,tsx,js,json,css,md}": "prettier --write"
  },
  "dependencies": {
    "@capacitor/app": "^5.0.0",
    "@capacitor/core": "^5.5.1",
    "@capacitor/filesystem": "^5.0.0",
    "@capacitor/preferences": "^5.0.0",
    "@capacitor/status-bar": "^5.0.0",
    "@gravity-ui/onboarding": "^1.11.7",
    "@lottiefiles/dotlottie-react": "^0.19.0",
    "@portal/module-sdk": "workspace:*",
    "@portal/modules-schedule": "workspace:*",
    "@portal/runtime": "workspace:*",
    "@portal/shared-api": "workspace:*",
    "@portal/shared-assets": "workspace:*",
    "@portal/shared-config": "workspace:*",
    "@portal/shared-lib": "workspace:*",
    "@portal/shared-module-types": "workspace:*",
    "@portal/shared-platform": "workspace:*",
    "@portal/shared-theme": "workspace:*",
    "@portal/shared-ui": "workspace:*",
    "@portal/shell": "workspace:*",
    "@sentry/react": "^10.10.0",
    "@tanstack/react-query": "^5.17.15",
    "@telegram-apps/sdk-react": "^3.3.6",
    "@types/telegram-web-app": "^9.0.0",
    "@yudiel/react-qr-scanner": "^2.3.1",
    "antd": "^6.1.0",
    "dayjs": "^1.11.18",
    "framer-motion": "^12.23.25",
    "html-react-parser": "^5.2.6",
    "jwt-decode": "^4.0.0",
    "lottie-react": "^2.4.1",
    "nuqs": "^2.8.9",
    "react": "^19.1.0",
    "react-datepicker": "^8.7.0",
    "react-dom": "^19.1.0",
    "react-insta-stories": "^2.8.0",
    "react-router-dom": "^7.8.0",
    "xlsx": "^0.18.5",
    "zod": "^3.22.4",
    "zustand": "^5.0.7",
    "@portal/module-composition": "workspace:*"
  },
  "devDependencies": {
    "@capacitor/cli": "^5.5.1",
    "@chromatic-com/storybook": "^5.0.1",
    "@storybook/addon-docs": "^10.2.10",
    "@storybook/addon-onboarding": "^10.2.10",
    "@storybook/addon-vitest": "^10.2.10",
    "@storybook/react-vite": "^10.2.10",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@typescript-eslint/eslint-plugin": "^6.19.0",
    "@typescript-eslint/parser": "^6.19.0",
    "@vitejs/plugin-react": "^4.2.1",
    "@vitest/browser-playwright": "^4.0.18",
    "@vitest/coverage-v8": "^4.0.18",
    "eslint": "^8.56.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^4.6.0",
    "eslint-plugin-react-refresh": "^0.4.5",
    "eslint-plugin-storybook": "^10.2.10",
    "playwright": "^1.58.2",
    "prettier": "^3.8.3",
    "storybook": "^10.2.10",
    "typescript": "^5.3.3",
    "vite": "^5.0.11",
    "vite-tsconfig-paths": "^5.1.4",
    "vitest": "^4.0.18"
  },
  "packageManager": "pnpm@10.32.1"
}
